# Server-side Supabase (use these on Vercel; may be Secret)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Required on Hostinger/production: order delete, admin uploads, stock restore (server-only; never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_BOOTSTRAP_EMAIL=budybear2026@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=your_admin_password
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Local: http://localhost:3000  |  Hostinger: https://budybear.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hostinger hPanel → Node.js app → Environment variables (rebuild after save)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Hostinger media (hPanel FTP account, not Gmail). Paste the same keys on the Node app.
HOSTINGER_FTP_HOST=ftp.budybear.com
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
HOSTINGER_FTP_PORT=21
HOSTINGER_REMOTE_DIR=/uploads
HOSTINGER_PUBLIC_BASE_URL=https://budybear.com/uploads
NEXT_PUBLIC_MEDIA_HOST=budybear.com

# Persistent image directory OUTSIDE public_html and hbuilds (required for Hostinger Node deploys).
# Example: /home/u123456789/domains/budybear.com/storage/uploads
MEDIA_ROOT=

# Hostinger MySQL (hPanel → Databases). Do not enable the cutover flag until migration is approved.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=8
USE_HOSTINGER_BACKEND=false
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=14d

# Optional Express API (used only when Supabase env vars are missing)
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Order-placement email to Budy Bear (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=budybear2026@gmail.com
SMTP_PASS=your_gmail_app_password
ORDER_NOTIFY_EMAIL=budybear2026@gmail.com
