# Server-side Supabase (use these on Vercel; may be Secret)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: admin image uploads on Vercel (use Secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_BOOTSTRAP_EMAIL=budybear2026@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=your_admin_password
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Local: http://localhost:3000  |  Hostinger: https://budybear.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hostinger hPanel → Node.js app → Environment variables (rebuild after save)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Hostinger media (hPanel FTP account, not Gmail). Paste the same keys on the Node app.
HOSTINGER_FTP_HOST=ftp.budybear.com
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
HOSTINGER_FTP_PORT=21
HOSTINGER_REMOTE_DIR=/public_html/media
HOSTINGER_PUBLIC_BASE_URL=https://budybear.com/media
NEXT_PUBLIC_MEDIA_HOST=budybear.com

# Optional Express API (used only when Supabase env vars are missing)
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Order-placement email to Budy Bear (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=budybear2026@gmail.com
SMTP_PASS=your_gmail_app_password
ORDER_NOTIFY_EMAIL=budybear2026@gmail.com
