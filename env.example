# Next.js talks to the separate API. Shoppers still see the local catalog
# if this is empty or the API is down. Admin writes fail instead of saving RAM-only data.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Hostname only, used by next/image for Hostinger or local API media
NEXT_PUBLIC_MEDIA_HOST=localhost
