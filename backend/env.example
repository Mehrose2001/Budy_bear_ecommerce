PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Supabase (service role stays on this API only — never in Next.js)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# First admin user created by `npm run bootstrap`
ADMIN_BOOTSTRAP_EMAIL=admin@budybear.pk
ADMIN_BOOTSTRAP_PASSWORD=Admin@1234
ADMIN_BOOTSTRAP_NAME=Budy Bear
ADMIN_BOOTSTRAP_PHONE=+92 333 0370236

# Local-only fallback when Supabase is not configured yet
ADMIN_DEV_TOKEN=bb-admin-demo

# Hostinger FTP for the 50GB media store (hPanel FTP account, not Gmail login)
HOSTINGER_FTP_HOST=
HOSTINGER_FTP_USER=
HOSTINGER_FTP_PASSWORD=
HOSTINGER_FTP_PORT=21
HOSTINGER_REMOTE_DIR=/public_html/media
HOSTINGER_PUBLIC_BASE_URL=

CATALOG_CACHE_MS=15000
REQUEST_TIMEOUT_MS=8000
